<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Engineer: DLR / gate pass on assigned projects -->
    <record id="rule_daily_labor_engineer" model="ir.rule">
        <field name="name">CEMS Engineer: DLR on assigned projects</field>
        <field name="model_id" ref="model_construction_daily_labor"/>
        <field name="domain_force">[('project_id.cems_engineer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('construction_progress.group_cems_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_gate_pass_engineer" model="ir.rule">
        <field name="name">CEMS Engineer: gate pass on assigned projects</field>
        <field name="model_id" ref="model_construction_gate_pass"/>
        <field name="domain_force">[('project_id.cems_engineer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('construction_progress.group_cems_engineer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager: own projects -->
    <record id="rule_daily_labor_manager" model="ir.rule">
        <field name="name">CEMS Manager: DLR on own projects</field>
        <field name="model_id" ref="model_construction_daily_labor"/>
        <field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('construction_progress.group_cems_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_gate_pass_manager" model="ir.rule">
        <field name="name">CEMS Manager: gate pass on own projects</field>
        <field name="model_id" ref="model_construction_gate_pass"/>
        <field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('construction_progress.group_cems_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Director: read all -->
    <record id="rule_daily_labor_director" model="ir.rule">
        <field name="name">CEMS Director: read all DLR</field>
        <field name="model_id" ref="model_construction_daily_labor"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('construction_progress.group_cems_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal worker: own gate passes only -->
    <record id="rule_gate_pass_portal_own" model="ir.rule">
        <field name="name">Portal: own gate passes</field>
        <field name="model_id" ref="model_construction_gate_pass"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
