<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CEMS split-screen login as website homepage (/) — matches portal_cems/index.html -->
    <template id="cems_login_homepage" name="CEMS Portal Login Home">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div id="wrap" class="cems-login-page">
                <div class="container-fluid g-0 min-vh-100">
                    <div class="row g-0 min-vh-100">

                        <!-- LEFT: Login form -->
                        <div class="col-12 col-lg-6 cems-login-form-pane d-flex flex-column">
                            <div class="cems-login-form-inner mx-auto my-auto w-100">
                                <a href="/" class="cems-logo d-inline-flex align-items-center gap-2 mb-4 text-decoration-none">
                                    <span class="cems-logo-mark" aria-hidden="true"/>
                                    CEMS <span>Portal</span>
                                </a>

                                <h1 class="cems-login-title">Log in to your account</h1>
                                <p class="cems-login-subtitle mb-4">Please enter your details</p>

                                <div t-if="error" class="alert alert-danger" role="alert">
                                    <t t-esc="error"/>
                                </div>

                                <form action="/cems/login" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="type" value="password"/>
                                    <input type="hidden" name="redirect" t-att-value="redirect or '/my'"/>

                                    <div class="mb-3">
                                        <label for="login" class="form-label fw-semibold">Email</label>
                                        <div class="input-group input-group-lg cems-input-group">
                                            <span class="input-group-text bg-white">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M4 6h16v12H4V6zm0 0l8 7 8-7" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </span>
                                            <input type="text"
                                                   class="form-control"
                                                   id="login"
                                                   name="login"
                                                   placeholder="Enter your email"
                                                   required="required"
                                                   autocapitalize="off"
                                                   autocomplete="username"
                                                   t-att-value="login or ''"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="password" class="form-label fw-semibold">Password</label>
                                        <div class="input-group input-group-lg cems-input-group">
                                            <span class="input-group-text bg-white">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/>
                                                    <rect x="5" y="11" width="14" height="10" rx="2" stroke="#94a3b8" stroke-width="2"/>
                                                    <circle cx="12" cy="16" r="1.25" fill="#94a3b8"/>
                                                </svg>
                                            </span>
                                            <input type="password"
                                                   class="form-control"
                                                   id="password"
                                                   name="password"
                                                   placeholder="••••••••"
                                                   required="required"
                                                   autocomplete="current-password"/>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" value="1" id="remember" name="remember"/>
                                            <label class="form-check-label" for="remember">Remember for 30 days</label>
                                        </div>
                                        <a href="/web/reset_password" class="cems-link-leaf fw-semibold text-decoration-none">Forgot password</a>
                                    </div>

                                    <button type="submit" class="btn cems-btn-touch cems-btn-primary w-100">
                                        Log in
                                    </button>
                                </form>

                                <p class="cems-login-legal text-center small mt-auto pt-5 mb-0">
                                    By signing in, you agree to our
                                    <a href="#terms" class="cems-link-leaf">Terms of Use</a>
                                    and geofence attendance consent.
                                </p>
                            </div>
                        </div>

                        <!-- Desktop-only brand / hero (hidden on mobile) -->
                        <div class="col-12 col-lg-6 cems-login-hero-col d-none d-lg-flex align-items-stretch">
                            <div class="cems-login-hero-pane flex-column position-relative overflow-hidden w-100 d-flex">
                                <div class="cems-login-hero-overlay"/>
                                <div class="cems-login-hero-content position-relative z-1 p-4 p-xl-5 flex-grow-1 d-flex flex-column justify-content-center">
                                    <p class="cems-hero-brand mb-2">PT DYNATECH BATAM</p>
                                    <h2 class="cems-hero-headline">
                                        Check in on site.<br/>
                                        Get work done safely.
                                    </h2>
                                    <p class="cems-hero-lead mb-0">
                                        Construction &amp; Engineering Management Suite — attendance, tasks, and site actions in one portal.
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
