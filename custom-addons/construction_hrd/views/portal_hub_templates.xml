<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared CEMS Portal Hub shell (sidebar + topbar)
         Approach C: layout is self-sufficient — always load menu via ir.http -->
    <template id="cems_portal_layout" name="CEMS Portal Hub Layout">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <!-- Fill / refresh shell context from current user + page_name -->
            <t t-set="_cems_shell"
               t-value="request.env['ir.http']._cems_portal_shell_values(page_name, page_title)"/>
            <t t-set="cems_menu" t-value="_cems_shell.get('cems_menu')"/>
            <t t-set="cems_user_name" t-value="_cems_shell.get('cems_user_name')"/>
            <t t-set="cems_user_email" t-value="_cems_shell.get('cems_user_email')"/>
            <t t-set="cems_partner_id" t-value="_cems_shell.get('cems_partner_id')"/>
            <t t-set="cems_partner_write_date" t-value="_cems_shell.get('cems_partner_write_date')"/>
            <t t-set="cems_is_internal" t-value="_cems_shell.get('cems_is_internal')"/>
            <t t-set="cems_is_portal" t-value="_cems_shell.get('cems_is_portal')"/>
            <t t-set="cems_can_daily_labor" t-value="_cems_shell.get('cems_can_daily_labor')"/>
            <t t-set="cems_active_menu" t-value="_cems_shell.get('cems_active_menu')"/>
            <t t-set="page_title" t-value="page_title or _cems_shell.get('page_title')"/>
            <div id="wrap">
                <div class="cems-portal-shell" id="o_cems_portal_shell">
                    <aside class="cems-hub-sidebar" id="o_cems_hub_sidebar" aria-label="CEMS navigation">
                        <div class="cems-hub-sidebar-top">
                            <a href="/my" class="cems-hub-brand">
                                <img src="/construction_hrd/static/src/img/dynatech_logo.png"
                                     alt="Dynatech"
                                     class="cems-hub-brand-logo"/>
                                <span class="cems-hub-brand-text">CEMS <span>Portal</span></span>
                            </a>
                            <button type="button"
                                    class="cems-hub-sidebar-close"
                                    id="o_cems_hub_sidebar_close"
                                    aria-label="Close menu">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M6 6l12 12M18 6L6 18"/>
                                </svg>
                            </button>
                        </div>
                        <ul class="cems-hub-nav">
                            <t t-set="cems_active" t-value="cems_active_menu or 'home'"/>
                            <t t-foreach="cems_menu or []" t-as="item">
                                <li>
                                    <a t-att-href="item['url']"
                                       t-att-class="'active' if item['id'] == cems_active else None">
                                        <span class="cems-hub-nav-icon" aria-hidden="true">
                                            <t t-if="item.get('icon') == 'dashboard'">
                                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'projects'">
                                                <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'tasks'">
                                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12l2.5 2.5L16 9"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'attendance'">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'gate'">
                                                <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="9" cy="12" r="2.25"/><path d="M14 10h5M14 14h3"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'labor'">
                                                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3.5"/><path d="M22 21v-2a3.5 3.5 0 0 0-2.5-3.35"/><path d="M16.5 3.7a3.5 3.5 0 0 1 0 6.6"/></svg>
                                            </t>
                                            <t t-elif="item.get('icon') == 'profile'">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                                            </t>
                                            <t t-else="">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/></svg>
                                            </t>
                                        </span>
                                        <t t-esc="item['label']"/>
                                    </a>
                                </li>
                            </t>
                        </ul>
                        <div class="cems-hub-sidebar-foot">
                            <a t-if="cems_is_internal" href="/web">Open Back Office</a>
                            <a href="/web/session/logout?redirect=/">Logout</a>
                        </div>
                    </aside>
                    <div class="cems-hub-nav-backdrop" id="o_cems_hub_nav_backdrop" hidden="hidden" aria-hidden="true"/>

                    <div class="cems-hub-main">
                        <header class="cems-hub-topbar">
                            <div class="cems-hub-topbar-left">
                                <button type="button"
                                        class="cems-hub-menu-toggle"
                                        id="o_cems_hub_menu_toggle"
                                        aria-label="Open menu"
                                        aria-controls="o_cems_hub_sidebar"
                                        aria-expanded="false">
                                    <span class="cems-hub-burger" aria-hidden="true">
                                        <span/>
                                        <span/>
                                        <span/>
                                    </span>
                                </button>
                                <a href="/my" class="cems-hub-topbar-brand d-lg-none">
                                    <img src="/construction_hrd/static/src/img/dynatech_logo.png"
                                         alt="Dynatech"
                                         class="cems-hub-topbar-logo"/>
                                    <span class="cems-hub-topbar-brand-text">CEMS <span>Portal</span></span>
                                </a>
                                <h1 class="d-none d-lg-block" t-esc="page_title or 'Dashboard'"/>
                            </div>
                            <div class="cems-hub-topbar-actions">
                                <h1 class="cems-hub-topbar-title-mobile d-lg-none" t-esc="page_title or 'Dashboard'"/>
                                <button type="button"
                                        class="cems-hub-notify"
                                        id="o_cems_hub_notify"
                                        aria-label="Notifications"
                                        title="Notifications">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5"/>
                                        <path d="M9.5 17a2.5 2.5 0 0 0 5 0"/>
                                    </svg>
                                </button>
                                <div class="cems-hub-account-wrap" id="o_cems_hub_account_wrap">
                                    <button type="button"
                                            class="cems-hub-account"
                                            id="o_cems_hub_account_btn"
                                            aria-haspopup="menu"
                                            aria-expanded="false"
                                            aria-controls="o_cems_hub_account_menu"
                                            title="Account menu">
                                        <img class="cems-hub-account-avatar"
                                             t-attf-src="/web/image/res.partner/{{cems_partner_id}}/avatar_128?unique={{cems_partner_write_date}}"
                                             alt=""/>
                                        <span class="cems-hub-account-meta d-none d-sm-flex">
                                            <span class="cems-hub-account-name" t-esc="cems_user_name"/>
                                            <span class="cems-hub-account-email" t-esc="cems_user_email"/>
                                        </span>
                                        <span class="cems-hub-account-caret d-none d-sm-inline" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                                        </span>
                                    </button>
                                    <div class="cems-hub-account-menu"
                                         id="o_cems_hub_account_menu"
                                         role="menu"
                                         hidden="hidden">
                                        <a href="/my/account" class="cems-hub-account-item" role="menuitem">
                                            <span class="cems-hub-account-item-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                                            </span>
                                            <span>My Profile</span>
                                        </a>
                                        <a href="/web/session/logout?redirect=/" class="cems-hub-account-item is-danger" role="menuitem">
                                            <span class="cems-hub-account-item-icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                                            </span>
                                            <span>Logout</span>
                                        </a>
                                    </div>
                                </div>
                                <a t-if="cems_is_internal" href="/web" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex">
                                    Back Office
                                </a>
                            </div>
                        </header>
                        <div class="cems-hub-content">
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
                <script type="text/javascript">
                    (function () {
                        var shell = document.getElementById('o_cems_portal_shell');
                        var btn = document.getElementById('o_cems_hub_menu_toggle');
                        var closeBtn = document.getElementById('o_cems_hub_sidebar_close');
                        var backdrop = document.getElementById('o_cems_hub_nav_backdrop');
                        var sidebar = document.getElementById('o_cems_hub_sidebar');
                        if (!shell || !btn) {
                            return;
                        }

                        function setOpen(open) {
                            shell.classList.toggle('sidebar-open', open);
                            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                            btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
                            if (backdrop) {
                                backdrop.hidden = !open;
                                backdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
                            }
                            document.body.classList.toggle('cems-hub-nav-open', open);
                        }

                        function toggle() {
                            setOpen(!shell.classList.contains('sidebar-open'));
                        }

                        function close() {
                            setOpen(false);
                        }

                        btn.addEventListener('click', function (ev) {
                            ev.preventDefault();
                            toggle();
                        });
                        if (closeBtn) {
                            closeBtn.addEventListener('click', function (ev) {
                                ev.preventDefault();
                                close();
                            });
                        }
                        if (backdrop) {
                            backdrop.addEventListener('click', close);
                        }
                        if (sidebar) {
                            sidebar.querySelectorAll('a').forEach(function (link) {
                                link.addEventListener('click', close);
                            });
                        }
                        document.addEventListener('keydown', function (ev) {
                            if (ev.key === 'Escape') {
                                close();
                            }
                        });
                        window.addEventListener('resize', function () {
                            if (window.innerWidth &gt;= 992) {
                                close();
                            }
                        });
                    })();
                </script>
            </div>
        </t>
    </template>

    <!-- /my Dashboard -->
    <template id="cems_portal_hub_home" name="CEMS Portal Hub Home">
        <t t-call="construction_hrd.cems_portal_layout">
            <div class="cems-hub-stats">
                <div class="cems-hub-stat">
                    <div class="cems-hub-stat-icon projects" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
                    </div>
                    <div>
                        <p class="cems-hub-stat-label">My Projects</p>
                        <p class="cems-hub-stat-value" t-esc="project_count"/>
                    </div>
                </div>
                <div class="cems-hub-stat">
                    <div class="cems-hub-stat-icon tasks" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12l2.5 2.5L16 9"/></svg>
                    </div>
                    <div>
                        <p class="cems-hub-stat-label">Open Tasks</p>
                        <p class="cems-hub-stat-value" t-esc="open_task_count"/>
                    </div>
                </div>
                <div class="cems-hub-stat">
                    <div class="cems-hub-stat-icon attendance" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </div>
                    <div>
                        <p class="cems-hub-stat-label">Attendance</p>
                        <p class="cems-hub-stat-value">
                            <t t-if="checked_in">In</t>
                            <t t-else="">Out</t>
                        </p>
                    </div>
                </div>
                <div class="cems-hub-stat">
                    <div class="cems-hub-stat-icon gates" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="9" cy="12" r="2.25"/><path d="M14 10h5M14 14h3"/></svg>
                    </div>
                    <div>
                        <p class="cems-hub-stat-label">Active Gate Passes</p>
                        <p class="cems-hub-stat-value" t-esc="gate_pass_count"/>
                    </div>
                </div>
            </div>

            <div class="cems-hub-panel cems-hub-attendance">
                <div class="cems-hub-att-header">
                    <h2 class="mb-0">Site Attendance</h2>
                    <a href="/my/cems/attendance" class="cems-hub-att-history">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 7v5l3 2"/>
                            <path d="M4.5 8.5A9 9 0 0 1 12 3"/>
                        </svg>
                        View history
                    </a>
                </div>

                <div t-if="error" class="alert alert-danger py-2 mb-3" role="alert">
                    <t t-if="error == 'outside_geofence'">
                        You are outside the site geofence. Move closer to the project site and try again.
                    </t>
                    <t t-elif="error == 'no_employee'">
                        No employee record is linked to your user. Contact HR / your supervisor.
                    </t>
                    <t t-elif="error == 'invalid_gps'">
                        Invalid GPS coordinates. Allow location access and try again.
                    </t>
                    <t t-elif="error == 'check_in_failed'">
                        Check-in failed. You may already have an open attendance.
                    </t>
                    <t t-elif="error == 'checkout_failed'">
                        Check-out failed. No open check-in was found.
                    </t>
                    <t t-else="">An error occurred. Please try again.</t>
                </div>
                <div t-if="success" class="alert alert-success py-2 mb-3" role="alert">
                    <t t-if="success == 'checked_in'">Checked in successfully.</t>
                    <t t-elif="success == 'checked_out'">Checked out successfully.</t>
                </div>

                <div class="cems-hub-att-body">
                    <div class="cems-hub-att-deco" aria-hidden="true">
                        <img src="/construction_hrd/static/src/img/attendance_deco.svg"
                             alt=""
                             width="320"
                             height="180"/>
                    </div>

                    <div class="cems-hub-att-clock">
                        <p class="cems-hub-att-time" id="o_cems_hub_clock">--:--:--</p>
                        <p class="cems-hub-att-date" id="o_cems_hub_date">&#160;</p>
                    </div>

                    <div class="cems-hub-att-status">
                        <t t-if="checked_in">
                            <span class="cems-hub-att-pill ok">Already checked in</span>
                            <p t-if="open_attendance" class="cems-hub-att-meta mb-0">
                                Since <span t-field="open_attendance.check_in"/>
                            </p>
                        </t>
                        <t t-else="">
                            <span class="cems-hub-att-pill muted">Haven't checked in</span>
                            <p class="cems-hub-att-meta mb-0">Ready when you arrive on site</p>
                        </t>
                    </div>

                    <div class="cems-hub-att-actions">
                        <t t-if="not employee">
                            <span class="cems-hub-att-btn ghost disabled" aria-disabled="true">
                                Link employee first
                            </span>
                        </t>
                        <t t-elif="not attendance_project and not checked_in">
                            <span class="cems-hub-att-btn ghost disabled" aria-disabled="true">
                                No site project
                            </span>
                        </t>
                        <t t-elif="checked_in">
                            <button type="button"
                                    class="cems-hub-att-btn dark"
                                    id="o_cems_att_open_btn"
                                    data-mode="check_out">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                </svg>
                                Check Out
                            </button>
                        </t>
                        <t t-else="">
                            <button type="button"
                                    class="cems-hub-att-btn primary"
                                    id="o_cems_att_open_btn"
                                    data-mode="check_in">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"/>
                                </svg>
                                Check In
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Attendance camera dialog -->
            <div class="cems-att-dialog" id="o_cems_att_dialog" hidden="hidden" aria-hidden="true">
                <div class="cems-att-dialog-backdrop" id="o_cems_att_dialog_backdrop"/>
                <div class="cems-att-dialog-card" role="dialog" aria-modal="true" aria-labelledby="o_cems_att_dialog_title">
                    <div class="cems-att-dialog-head">
                        <h3 id="o_cems_att_dialog_title">Check In</h3>
                        <button type="button" class="cems-att-dialog-close" id="o_cems_att_dialog_close" aria-label="Close">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                    </div>

                    <form id="o_cems_att_dialog_form"
                          method="post"
                          enctype="multipart/form-data"
                          t-att-action="'/my/cems/attendance/check_out' if checked_in else '/my/cems/attendance/check_in'">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="next" value="/my"/>
                        <input type="hidden" name="latitude" id="o_cems_att_latitude" value=""/>
                        <input type="hidden" name="longitude" id="o_cems_att_longitude" value=""/>
                        <input type="file" class="d-none" name="selfie" id="o_cems_att_selfie" accept="image/*"/>

                        <div class="cems-att-camera-stage" id="o_cems_att_camera_stage">
                            <video id="o_cems_att_video"
                                   class="cems-att-video"
                                   playsinline="playsinline"
                                   autoplay="autoplay"
                                   muted="muted"/>
                            <canvas id="o_cems_att_canvas" class="d-none"/>
                            <img id="o_cems_att_snapshot" class="cems-att-snapshot d-none" alt="Captured selfie"/>

                            <div class="cems-att-permission d-none" id="o_cems_att_permission" role="alert">
                                <p class="cems-att-permission-title">Permission not allowed</p>
                                <p class="cems-att-permission-lead" id="o_cems_att_permission_lead">
                                    Camera or location access is blocked for this site.
                                </p>
                                <p class="cems-att-permission-how">How to allow permission</p>
                                <ol class="cems-att-permission-steps" id="o_cems_att_permission_steps">
                                    <li>Tap the lock / info icon in the browser address bar.</li>
                                    <li>Find <strong>Camera</strong> and/or <strong>Location</strong>.</li>
                                    <li>Change them to <strong>Allow</strong>.</li>
                                    <li>Reload this page, then open Check In again.</li>
                                    <li>If still blocked: device Settings → Apps / Safari → Site permissions → Allow.</li>
                                </ol>
                                <button type="button"
                                        class="cems-att-permission-retry"
                                        id="o_cems_att_permission_retry">
                                    Try again
                                </button>
                            </div>
                        </div>

                        <p class="cems-att-dialog-error d-none" id="o_cems_att_dialog_error"/>

                        <div class="cems-att-dialog-actions">
                            <button type="button"
                                    class="cems-att-shutter"
                                    id="o_cems_att_capture"
                                    aria-label="Capture">
                                <svg class="cems-att-icon-capture" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="8"/>
                                    <circle cx="12" cy="12" r="4.5"/>
                                </svg>
                                <svg class="cems-att-icon-retake d-none" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 12a9 9 0 0 1 15.5-6.4"/>
                                    <path d="M21 3v7h-7"/>
                                    <path d="M21 12a9 9 0 0 1-15.5 6.4"/>
                                    <path d="M3 21v-7h7"/>
                                </svg>
                            </button>
                            <button type="submit"
                                    class="cems-hub-att-btn primary d-none"
                                    id="o_cems_att_submit"
                                    disabled="disabled">
                                <t t-if="checked_in">Check Out</t>
                                <t t-else="">Check In</t>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="cems-hub-panel h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="mb-0">My Projects</h2>
                            <a href="/my/projects" class="cems-hub-link">View all</a>
                        </div>
                        <ul class="cems-hub-list" t-if="hub_projects">
                            <t t-foreach="hub_projects" t-as="project">
                                <li>
                                    <a t-att-href="'/my/projects' if cems_is_portal else ('/my/projects/%s' % project.id)"
                                       t-esc="project.display_name"/>
                                </li>
                            </t>
                        </ul>
                        <p t-else="" class="cems-hub-muted mb-0">No projects assigned yet.</p>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="cems-hub-panel h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="mb-0">My Tasks</h2>
                            <a href="/my/tasks" class="cems-hub-link">View all</a>
                        </div>
                        <ul class="cems-hub-list" t-if="hub_tasks">
                            <t t-foreach="hub_tasks" t-as="task">
                                <li>
                                    <a t-att-href="'/my/tasks/%s' % task.id" t-esc="task.display_name"/>
                                </li>
                            </t>
                        </ul>
                        <p t-else="" class="cems-hub-muted mb-0">No open tasks.</p>
                    </div>
                </div>
            </div>

            <div t-if="cems_can_daily_labor" class="cems-hub-panel mt-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1">Daily Labor</h2>
                        <p class="cems-hub-muted mb-0">Review site headcount reports (read list).</p>
                    </div>
                    <a href="/my/cems/daily_labor" class="btn btn-sm" style="background:#0d9488;color:#fff;font-weight:600;">Open list</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Gate passes list -->
    <template id="cems_portal_gate_passes" name="CEMS Portal Gate Passes">
        <t t-call="construction_hrd.cems_portal_layout">
            <div class="cems-hub-panel">
                <h2>Gate Passes</h2>
                <p class="cems-hub-muted">Read-only list for Phase 2. Create/approve in Back Office if you have access.</p>
                <div t-if="not gate_passes" class="alert alert-light border mb-0">
                    No gate passes found.
                </div>
                <div t-else="" class="table-responsive">
                    <table class="cems-hub-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Project</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="gate_passes" t-as="gp">
                                <tr>
                                    <td t-esc="gp.name"/>
                                    <td><span t-field="gp.date"/></td>
                                    <td t-esc="gp.project_id.display_name"/>
                                    <td t-esc="gp.pass_type"/>
                                    <td>
                                        <span t-att-class="'cems-hub-badge ok' if gp.state == 'approved' else 'cems-hub-badge'"
                                              t-esc="gp.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!-- Daily labor list (engineer+) -->
    <template id="cems_portal_daily_labor" name="CEMS Portal Daily Labor">
        <t t-call="construction_hrd.cems_portal_layout">
            <div class="cems-hub-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h2 class="mb-0">Daily Labor Reports</h2>
                    <a t-if="cems_is_internal" href="/web" class="cems-hub-link">Create / edit in Back Office</a>
                </div>
                <p class="cems-hub-muted">List filtered by your CEMS record rules. Creating reports stays in Back Office.</p>
                <div t-if="not labor_reports" class="alert alert-light border mb-0">
                    No daily labor reports visible.
                </div>
                <div t-else="" class="table-responsive">
                    <table class="cems-hub-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Project</th>
                                <th>Headcount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="labor_reports" t-as="lab">
                                <tr>
                                    <td t-esc="lab.name"/>
                                    <td><span t-field="lab.date"/></td>
                                    <td t-esc="lab.project_id.display_name"/>
                                    <td t-esc="lab.total_headcount"/>
                                    <td>
                                        <span t-att-class="'cems-hub-badge ok' if lab.state == 'approved' else ('cems-hub-badge warn' if lab.state == 'submitted' else 'cems-hub-badge')"
                                              t-esc="lab.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
