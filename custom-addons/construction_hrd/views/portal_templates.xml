<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal home card -->
    <template id="portal_my_home_cems_attendance" name="CEMS Site Attendance"
              inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/construction_hrd/static/src/img/attendance.svg'"/>
                <t t-set="title">Site Attendance</t>
                <t t-set="text">Geofenced check-in / check-out with selfie</t>
                <t t-set="url" t-value="'/my/cems/attendance'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_attendance_page" name="CEMS Site Attendance">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Site Attendance</t>
            </t>

            <div class="container o_cems_portal_attendance mt-3 mb-5" id="o_cems_portal_attendance"
                 t-att-data-has-open="1 if open_attendance else 0">

                <div t-if="error" class="alert alert-danger" role="alert">
                    <t t-if="error == 'outside_geofence'">
                        You are outside the site geofence. Move closer to the project site and try again.
                    </t>
                    <t t-elif="error == 'no_employee'">
                        No employee record is linked to your user. Contact HR / your supervisor.
                    </t>
                    <t t-elif="error == 'invalid_gps'">
                        Invalid GPS coordinates. Allow location access and try again.
                    </t>
                    <t t-elif="error == 'check_in_failed'">
                        Check-in failed. You may already have an open attendance.
                    </t>
                    <t t-elif="error == 'checkout_failed'">
                        Check-out failed. No open check-in was found.
                    </t>
                    <t t-else="">An error occurred. Please try again.</t>
                </div>
                <div t-if="success" class="alert alert-success" role="alert">
                    <t t-if="success == 'checked_in'">Checked in successfully.</t>
                    <t t-elif="success == 'checked_out'">Checked out successfully.</t>
                </div>

                <div t-if="not employee" class="alert alert-warning">
                    Your portal user is not linked to an employee. Ask an administrator to set
                    <strong>Related User</strong> on your employee record, and add you to the
                    project <strong>Site Team</strong>.
                </div>

                <t t-else="">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title" t-esc="employee.name"/>
                            <p class="mb-1">
                                <strong>Site Project:</strong>
                                <t t-if="project" t-esc="project.display_name"/>
                                <t t-else=""><span class="text-danger">Not assigned</span></t>
                            </p>
                            <p t-if="project" class="mb-0 text-muted small">
                                Geofence radius:
                                <t t-esc="project.geofence_radius"/> m
                                (center
                                <t t-esc="'%.5f' % (project.geofence_latitude or 0)"/>,
                                <t t-esc="'%.5f' % (project.geofence_longitude or 0)"/>)
                            </p>
                            <p t-if="open_attendance" class="mt-2 mb-0">
                                <span class="badge text-bg-success">Checked in</span>
                                since
                                <span t-field="open_attendance.check_in"/>
                            </p>
                        </div>
                    </div>

                    <div t-if="not project" class="alert alert-danger">
                        You are not on any project Site Team, or geofence is not configured.
                        Ask your supervisor to add your user under
                        <strong>Project → CEMS / Geofence → Site Team</strong>
                        and set the project geofence.
                    </div>

                    <form t-if="project and not open_attendance"
                          id="o_cems_check_in_form"
                          action="/my/cems/attendance/check_in"
                          method="post"
                          enctype="multipart/form-data"
                          class="card card-body">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="latitude" id="o_cems_latitude" value=""/>
                        <input type="hidden" name="longitude" id="o_cems_longitude" value=""/>

                        <h5 class="mb-3">Check In</h5>
                        <p class="text-muted">
                            Allow GPS, take a selfie, then submit. The server validates your
                            position against the project geofence.
                        </p>

                        <div class="mb-3 o_cems_selfie_camera" id="o_cems_selfie_camera">
                            <label class="form-label">Selfie</label>
                            <p class="text-muted small mb-2">
                                Open the camera, then capture your face. File picker is not used.
                            </p>
                            <div class="o_cems_camera_preview mb-2">
                                <video id="o_cems_camera_video"
                                       class="o_cems_camera_video w-100 rounded border"
                                       playsinline="playsinline"
                                       autoplay="autoplay"
                                       muted="muted"></video>
                                <canvas id="o_cems_camera_canvas" class="d-none"></canvas>
                                <img id="o_cems_camera_snapshot"
                                     class="o_cems_camera_snapshot w-100 rounded border d-none"
                                     alt="Selfie preview"/>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        id="o_cems_camera_start">
                                    Open Camera
                                </button>
                                <button type="button" class="btn btn-primary btn-sm"
                                        id="o_cems_camera_capture" disabled="disabled">
                                    Capture Selfie
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm d-none"
                                        id="o_cems_camera_retake">
                                    Retake
                                </button>
                            </div>
                            <div class="small text-danger d-none" id="o_cems_camera_error"></div>
                            <div class="small text-success d-none" id="o_cems_camera_ok">
                                Selfie captured. You can check in.
                            </div>
                            <!-- Populated by JS from canvas; submitted as multipart file -->
                            <input type="file"
                                   class="d-none"
                                   name="selfie"
                                   id="o_cems_selfie"
                                   accept="image/*"/>
                        </div>

                        <div class="mb-3 o_cems_gps_box">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        id="o_cems_gps_btn">
                                    Enable GPS
                                </button>
                                <span class="badge text-bg-secondary" id="o_cems_gps_status">
                                    GPS not ready — click Enable GPS
                                </span>
                            </div>
                            <div class="small text-muted">
                                Use http://localhost:8069 (or HTTPS). Allow Location when the browser asks.
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-primary"
                                id="o_cems_check_in_btn"
                                disabled="disabled">
                            Check In
                        </button>
                    </form>

                    <form t-if="project and open_attendance"
                          id="o_cems_check_out_form"
                          action="/my/cems/attendance/check_out"
                          method="post"
                          class="card card-body">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="latitude" id="o_cems_out_latitude" value=""/>
                        <input type="hidden" name="longitude" id="o_cems_out_longitude" value=""/>
                        <h5 class="mb-3">Check Out</h5>
                        <div class="mb-3 o_cems_gps_box">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        id="o_cems_out_gps_btn">
                                    Enable GPS
                                </button>
                                <span class="badge text-bg-secondary" id="o_cems_out_gps_status">
                                    GPS optional for check-out
                                </span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-secondary" id="o_cems_check_out_btn">
                            Check Out
                        </button>
                    </form>
                </t>
            </div>
        </t>
    </template>
</odoo>
