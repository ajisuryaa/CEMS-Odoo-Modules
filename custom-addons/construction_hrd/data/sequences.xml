<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_construction_daily_labor" model="ir.sequence">
        <field name="name">Daily Labor Report</field>
        <field name="code">construction.daily.labor</field>
        <field name="prefix">DLR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_construction_gate_pass" model="ir.sequence">
        <field name="name">Gate Pass</field>
        <field name="code">construction.gate.pass</field>
        <field name="prefix">GP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
